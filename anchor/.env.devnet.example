# Devnet demo settings. Copy to anchor/.env (gitignored) for `docker compose up`.
RPC_URL=https://api.devnet.solana.com
KEEPER_EXPECTED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
# Overridden inside the container by docker-compose.yml (/secrets/keeper.json, /data/keeper-state.json)
KEEPER_KEYPAIR=keeper/devnet-keeper-keypair.json
KEEPER_STATE=keeper/devnet-keeper-state.json
# Seconds past the deadline (finalized Clock) before the keeper signs (REQ26).
KEEPER_SAFETY_MARGIN=10
